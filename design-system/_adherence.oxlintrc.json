{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/annotation/**",
              "components/brand/**",
              "components/conversation/**",
              "components/display/**",
              "components/feedback/**",
              "components/inputs/**",
              "components/navigation/**",
              "ui_kits/writing-tool/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:ABC Diatype))/i]",
        "message": "Font not provided by the design system. Available: ABC Diatype."
      },
      {
        "selector": "JSXOpeningElement[name.name='Annotation'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|scope|n|count|priority|why|conflict|suggestion|move|source|compare|active|collapsed|acceptLabel|onAccept|onSecondary|secondaryLabel|onDismiss|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<Annotation> doesn't accept that prop. Declared props: kind, scope, n, count, priority, why, conflict, suggestion, move, source, compare, active, collapsed, acceptLabel, onAccept, onSecondary, secondaryLabel, onDismiss, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Annotation'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:muss|sollte|geschmack)$/]",
        "message": "<Annotation> priority must be one of 'muss' | 'sollte' | 'geschmack'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aura'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|state|label|key|ref|className|style|children)$/]",
        "message": "<Aura> doesn't accept that prop. Declared props: size, state, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aura'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|thinking|quiet)$/]",
        "message": "<Aura> state must be one of 'idle' | 'thinking' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|tinted|online|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, tinted, online."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|warning|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|seat|name|meta|avatar|card|actions|thinking|children|className|key|ref|className|style|children)$/]",
        "message": "<Bubble> doesn't accept that prop. Declared props: from, seat, name, meta, avatar, card, actions, thinking, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:agent|user)$/]",
        "message": "<Bubble> from must be one of 'agent' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='seat'] > Literal[value!=/^(?:left|top)$/]",
        "message": "<Bubble> seat must be one of 'left' | 'top'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|loading|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|actions|padding|interactive|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, subtitle, actions, padding, interactive."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|onChange|onSubmit|onStop|placeholder|leading|hint|maxLength|busy|disabled|rows|className|style|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, defaultValue, onChange, onSubmit, onStop, placeholder, leading, hint, maxLength, busy, disabled, rows, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Correction'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|to|note|align|open|onAccept|onDismiss|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Correction> doesn't accept that prop. Declared props: kind, to, note, align, open, onAccept, onDismiss, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Correction'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Correction> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|description|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, description, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|size|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|secondary)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Insertion'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|label|acceptLabel|open|onAccept|onDismiss|onClick|key|ref|className|style|children)$/]",
        "message": "<Insertion> doesn't accept that prop. Declared props: text, label, acceptLabel, open, onAccept, onDismiss, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|n|active|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: kind, n, active, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rewrite'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|to|meta|acceptLabel|dismissLabel|onAccept|onDismiss|children|key|ref|className|style|children)$/]",
        "message": "<Rewrite> doesn't accept that prop. Declared props: label, to, meta, acceptLabel, dismissLabel, onAccept, onDismiss, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, hint, error, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|text|onAccept|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: label, text, onAccept, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:onRemove|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|rows|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: label, hint, error, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|description|actionLabel|onAction|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, title, description, actionLabel, onAction, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger)$/]",
        "message": "<Toast> tone must be one of 'info' | 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|shortcut|side|children|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, shortcut, side, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<Tooltip> side must be one of 'top' | 'bottom'."
      }
    ]
  },
